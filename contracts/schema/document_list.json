{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fkh.local/schema/document_list.json",
  "title": "DocumentList",
  "description": "GET /v1/knowledge/documents（2026-11-07 L1 裁决）：先取每个文档的最新版本，再按数据范围与状态过滤，最后排序分页；最新版本不可见时整条文档消失，不回退旧版本。",
  "type": "object",
  "additionalProperties": false,
  "required": ["total", "limit", "offset", "items"],
  "properties": {
    "total": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
    "offset": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "knowledge_key",
          "domain",
          "owner_department",
          "version_id",
          "version_no",
          "title",
          "status",
          "classification",
          "audience",
          "required_scope",
          "created_at",
          "chunk_count"
        ],
        "properties": {
          "document_id": { "type": "string" },
          "knowledge_key": { "type": "string" },
          "domain": { "type": "string" },
          "owner_department": { "type": "string" },
          "version_id": { "type": "string" },
          "version_no": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "RAW",
              "DRAFT",
              "REVIEWED",
              "APPROVED_INTERNAL",
              "PUBLISHED_PUBLIC",
              "SUPERSEDED",
              "REVOKED",
              "DISCARDED"
            ]
          },
          "classification": { "type": "integer", "minimum": 0, "maximum": 4 },
          "audience": { "type": "string", "enum": ["internal", "customer_public"] },
          "required_scope": {
            "type": "string",
            "enum": ["internal_product", "internal_training", "customer_public"]
          },
          "created_at": { "type": ["string", "null"] },
          "chunk_count": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
