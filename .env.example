# 复制为 .env 后按需填写。不要提交真实密钥。
# 任何一项留空，对应能力直接不可用（fail-closed），不会回退到默认放行值。

FKH_ENV=local

# 数据库：留空时 /health/ready 返回 503 degraded
# 生产必须使用无 BYPASSRLS、非表 owner 的业务角色
FKH_DATABASE_URL=

# 身份：ADR-02 未签署前仅支持本地 HS256
# 留空时所有认证请求返回 401
FKH_JWT_SECRET=
FKH_JWT_ISSUER=fkh.local
FKH_JWT_AUDIENCE=fkh-api

# 检索初始值（L1 §4.4 试验值，不是验收阈值）
FKH_RETRIEVAL_DENSE_TOP_K=30
FKH_RETRIEVAL_LEXICAL_TOP_K=30
FKH_RRF_K=60
FKH_EVIDENCE_MAX=5
