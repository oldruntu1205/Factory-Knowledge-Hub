# 复制为 .env 后按需填写。不要提交真实密钥。
# 任何一项留空，对应能力直接不可用（fail-closed），不会回退到默认放行值。

FKH_ENV=local

# 数据库：留空时 /health/ready 返回 503 degraded
# 生产必须使用无 BYPASSRLS、非表 owner 的业务角色
FKH_DATABASE_URL=

# 身份：ADR-02 未签署前仅支持本地 HS256
# 留空时所有认证请求返回 401
FKH_JWT_SECRET=
FKH_JWT_ISSUER=fkh.local
FKH_JWT_AUDIENCE=fkh-api

# 检索初始值（L1 §4.4 试验值，不是验收阈值）
FKH_RETRIEVAL_DENSE_TOP_K=30
FKH_RETRIEVAL_LEXICAL_TOP_K=30
FKH_RRF_K=60
FKH_EVIDENCE_MAX=5

# 召回模式：lexical = 纯词法（默认，行为与接线前一致）；hybrid = 向量+词法 RRF 融合
# 这是服务端配置，不是请求参数；hybrid 缺模型/推理失败一律 503，不静默降级
FKH_RETRIEVAL_MODE=lexical

# Embedding（仅 hybrid 生效；数据不出境，只加载本地权重，无远程 endpoint 配置）
# provider: none | bge-m3 | test（test 只允许 local/dev/test/ci，生产配置会被拒绝）
# 真实推理需先 `uv sync --extra embedding` 并下载 BAAI/bge-m3 权重
FKH_EMBEDDING_PROVIDER=none
FKH_EMBEDDING_DEVICE=cpu
FKH_EMBEDDING_BATCH_SIZE=8

# 检索审计密钥：query 只以 HMAC 落库（普通哈希可被字典反推短查询）
# 留空时 /v1/knowledge/search 返回 503，不会退化成明文或弱哈希
FKH_RETRIEVAL_HASH_KEY=
FKH_RETRIEVAL_HASH_KEY_ID=k1

# outbox 投递（relay 进程用 fkh_relay 角色的连接串，不要复用业务串）
# FKH_OUTBOX_TRANSPORT 只支持 webhook；留空/none 时 relay 拒绝启动（fail-closed）
FKH_OUTBOX_TRANSPORT=none
FKH_OUTBOX_WEBHOOK_URL=
FKH_OUTBOX_TIMEOUT_SECONDS=10
FKH_OUTBOX_PRODUCER=knowledge-api
FKH_OUTBOX_BATCH_SIZE=20
FKH_OUTBOX_LEASE_SECONDS=30
FKH_OUTBOX_MAX_ATTEMPTS=8
FKH_OUTBOX_BACKOFF_BASE_SECONDS=2
FKH_OUTBOX_BACKOFF_CAP_SECONDS=300
